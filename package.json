{
  "name": "meva-initiative",
  "version": "1.0.0",
  "description": "Portail officiel MEVA Initiative - Star Wars: Unlimited",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev:css": "tailwindcss -i ./src/css/input.css -o ./public/css/style.css --watch",
    "build:css": "tailwindcss -i ./src/css/input.css -o ./public/css/style.css --minify",
    "build:js": "node scripts/build-firebase.mjs",
    "build": "npm run config && npm run build:js && npm run build:css",
    "config": "node scripts/generate-firebase-config.mjs prod",
    "config:dev": "node scripts/generate-firebase-config.mjs dev",
    "serve": "npm run build && firebase serve --only hosting",
    "dev": "node scripts/dev.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"npx jest tests/security/security.test.js --runInBand\""
  },
  "dependencies": {
    "firebase": "13.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "esbuild": "0.28.2",
    "jest": "^29.7.0",
    "tailwindcss": "^3.4.1"
  }
}
