# Firebase web config (public values, not secrets).
# Layering (highest priority first): shell env > .env.local > .env.dev (dev mode only) > .env
# Copy to .env.local for personal overrides.
#
# The project id is NOT set here: it comes from .firebaserc ("default" in prod,
# "dev" alias when emulators are enabled).

# Required
FIREBASE_API_KEY=
FIREBASE_APP_ID=

# Optional
FIREBASE_MEASUREMENT_ID=
# Realtime Database region, used to build the databaseURL (us-central1 gives the legacy firebaseio.com URL)
FIREBASE_DATABASE_REGION=

# Derived from the project id / app id, set only to override the convention
# (custom auth domain, legacy .appspot.com bucket, ...)
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_DATABASE_URL=
# FIREBASE_MESSAGING_SENDER_ID=

# Emulators (set to true in .env.dev only). Ports are read from firebase.json.
FIREBASE_USE_EMULATORS=false
FIREBASE_EMULATOR_HOST=localhost
