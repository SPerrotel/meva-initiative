# Dev overrides: everything points at the local Firebase emulators.
# The project id is the .firebaserc "dev" alias, which must start with "demo-"
# so the emulators never touch real resources.
FIREBASE_API_KEY=demo-api-key
FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# No analytics in dev (overrides the value from .env)
FIREBASE_MEASUREMENT_ID=

FIREBASE_USE_EMULATORS=true
