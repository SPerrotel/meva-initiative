# Dev overrides: everything points at the local Firebase emulators.
# The "demo-" project prefix guarantees the emulators never touch real resources.
FIREBASE_API_KEY=demo-api-key
FIREBASE_AUTH_DOMAIN=demo-meva-initiative.firebaseapp.com
FIREBASE_PROJECT_ID=demo-meva-initiative
FIREBASE_STORAGE_BUCKET=demo-meva-initiative.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
FIREBASE_MEASUREMENT_ID=G-DEMO000000
FIREBASE_DATABASE_URL=https://demo-meva-initiative-default-rtdb.europe-west1.firebasedatabase.app

FIREBASE_USE_EMULATORS=true
